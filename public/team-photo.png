<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='900' viewBox='0 0 1600 900'>
  <defs>
    <linearGradient id='bg' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#ffffff'/>
      <stop offset='60%' stop-color='#f0f9ff'/>
      <stop offset='100%' stop-color='#e0f2fe'/>
    </linearGradient>
    <linearGradient id='accent' x1='0%' y1='0%' x2='100%' y2='0%'>
      <stop offset='0%' stop-color='#0284c7'/>
      <stop offset='50%' stop-color='#0ea5e9'/>
      <stop offset='100%' stop-color='#38bdf8'/>
    </linearGradient>
    <linearGradient id='gold' x1='0%' y1='0%' x2='100%' y2='0%'>
      <stop offset='0%' stop-color='#d97706'/>
      <stop offset='100%' stop-color='#f59e0b'/>
    </linearGradient>
    <filter id='shadow' x='-10%' y='-10%' width='120%' height='120%'>
      <feDropShadow dx='0' dy='8' stdDeviation='12' flood-color='#0284c7' flood-opacity='0.12'/>
    </filter>
  </defs>

  <!-- Clean Bright Studio Background -->
  <rect width='1600' height='900' fill='url(#bg)'/>
  
  <!-- Subtle Modern Studio Grid Overlay -->
  <g opacity='0.25' stroke='#bae6fd' stroke-width='1'>
    <line x1='0' y1='0' x2='0' y2='900'/><line x1='100' y1='0' x2='100' y2='900'/><line x1='200' y1='0' x2='200' y2='900'/><line x1='300' y1='0' x2='300' y2='900'/><line x1='400' y1='0' x2='400' y2='900'/><line x1='500' y1='0' x2='500' y2='900'/><line x1='600' y1='0' x2='600' y2='900'/><line x1='700' y1='0' x2='700' y2='900'/><line x1='800' y1='0' x2='800' y2='900'/><line x1='900' y1='0' x2='900' y2='900'/><line x1='1000' y1='0' x2='1000' y2='900'/><line x1='1100' y1='0' x2='1100' y2='900'/><line x1='1200' y1='0' x2='1200' y2='900'/><line x1='1300' y1='0' x2='1300' y2='900'/><line x1='1400' y1='0' x2='1400' y2='900'/><line x1='1500' y1='0' x2='1500' y2='900'/>
    <line x1='0' y1='0' x2='1600' y2='0'/><line x1='0' y1='100' x2='1600' y2='100'/><line x1='0' y1='200' x2='1600' y2='200'/><line x1='0' y1='300' x2='1600' y2='300'/><line x1='0' y1='400' x2='1600' y2='400'/><line x1='0' y1='500' x2='1600' y2='500'/><line x1='0' y1='600' x2='1600' y2='600'/><line x1='0' y1='700' x2='1600' y2='700'/><line x1='0' y1='800' x2='1600' y2='800'/>
  </g>

  <!-- Top Decorative Accent Bar -->
  <rect x='0' y='0' width='1600' height='12' fill='url(#accent)'/>

  <!-- Top Pill Badge -->
  <g transform='translate(800, 110)'>
    <rect x='-200' y='-28' width='400' height='56' rx='28' fill='#ffffff' stroke='#0284c7' stroke-width='2' filter='url(#shadow)'/>
    <text x='0' y='9' font-family='system-ui, -apple-system, sans-serif' font-size='20' font-weight='800' fill='#0284c7' text-anchor='middle' letter-spacing='4'>TEAM ABU • Q4 2026</text>
  </g>

  <!-- Main Showcase Headlines -->
  <text x='800' y='210' font-family='system-ui, -apple-system, sans-serif' font-size='50' font-weight='900' fill='#0f172a' text-anchor='middle' letter-spacing='1'>AGILE PI PLANNING CREW</text>
  <text x='800' y='255' font-family='system-ui, -apple-system, sans-serif' font-size='20' font-weight='700' fill='#0284c7' text-anchor='middle' letter-spacing='1'>Official Engineering &amp; Product Squad</text>

  <!-- Group Showcase Cards (6 Team Members in Bright Modern Cards) -->
  <g transform='translate(800, 520)'>
    <!-- Stage Ambient Glow -->
    <ellipse cx='0' cy='180' rx='660' ry='48' fill='#38bdf8' opacity='0.2'/>
    
    <!-- Member 1: Cloud Architect -->
    <g transform='translate(-420, 0)' filter='url(#shadow)'>
      <rect x='-75' y='-150' width='150' height='270' rx='20' fill='#ffffff' stroke='#e2e8f0' stroke-width='2'/>
      <circle cx='0' cy='-70' r='46' fill='#0284c7'/>
      <text x='0' y='-60' font-family='sans-serif' font-size='28' font-weight='900' fill='#ffffff' text-anchor='middle'>AR</text>
      <text x='0' y='30' font-family='sans-serif' font-size='18' font-weight='800' fill='#0f172a' text-anchor='middle'>Alex Rivera</text>
      <text x='0' y='55' font-family='sans-serif' font-size='14' font-weight='700' fill='#0284c7' text-anchor='middle'>Cloud Architect</text>
      <rect x='-50' y='75' width='100' height='22' rx='11' fill='#f0f9ff'/>
      <text x='0' y='90' font-family='sans-serif' font-size='11' font-weight='700' fill='#0284c7' text-anchor='middle'>Infrastructure</text>
    </g>

    <!-- Member 2: AI Lead -->
    <g transform='translate(-250, -30)' filter='url(#shadow)'>
      <rect x='-75' y='-150' width='150' height='270' rx='20' fill='#ffffff' stroke='#10b981' stroke-width='2'/>
      <circle cx='0' cy='-70' r='46' fill='#10b981'/>
      <text x='0' y='-60' font-family='sans-serif' font-size='28' font-weight='900' fill='#ffffff' text-anchor='middle'>MT</text>
      <text x='0' y='30' font-family='sans-serif' font-size='18' font-weight='800' fill='#0f172a' text-anchor='middle'>Marcus Thorne</text>
      <text x='0' y='55' font-family='sans-serif' font-size='14' font-weight='700' fill='#059669' text-anchor='middle'>AI Agent Lead</text>
      <rect x='-50' y='75' width='100' height='22' rx='11' fill='#ecfdf5'/>
      <text x='0' y='90' font-family='sans-serif' font-size='11' font-weight='700' fill='#059669' text-anchor='middle'>LLM Systems</text>
    </g>

    <!-- Member 3: Abu Bakr (Team Lead) -->
    <g transform='translate(-85, -60)' filter='url(#shadow)'>
      <rect x='-80' y='-160' width='160' height='290' rx='22' fill='#ffffff' stroke='#f59e0b' stroke-width='3'/>
      <circle cx='0' cy='-75' r='52' fill='#f59e0b'/>
      <text x='0' y='-64' font-family='sans-serif' font-size='32' font-weight='900' fill='#ffffff' text-anchor='middle'>AB</text>
      <text x='0' y='32' font-family='sans-serif' font-size='20' font-weight='900' fill='#0f172a' text-anchor='middle'>Abu Bakr</text>
      <text x='0' y='58' font-family='sans-serif' font-size='14' font-weight='800' fill='#d97706' text-anchor='middle'>Team Abu Lead</text>
      <rect x='-55' y='78' width='110' height='24' rx='12' fill='#fffbeb'/>
      <text x='0' y='94' font-family='sans-serif' font-size='12' font-weight='800' fill='#d97706' text-anchor='middle'>⭐ Engineering</text>
    </g>

    <!-- Member 4: Product Owner -->
    <g transform='translate(85, -60)' filter='url(#shadow)'>
      <rect x='-80' y='-160' width='160' height='290' rx='22' fill='#ffffff' stroke='#0284c7' stroke-width='3'/>
      <circle cx='0' cy='-75' r='52' fill='#0284c7'/>
      <text x='0' y='-64' font-family='sans-serif' font-size='32' font-weight='900' fill='#ffffff' text-anchor='middle'>SP</text>
      <text x='0' y='32' font-family='sans-serif' font-size='20' font-weight='900' fill='#0f172a' text-anchor='middle'>Sarah Patel</text>
      <text x='0' y='58' font-family='sans-serif' font-size='14' font-weight='800' fill='#0284c7' text-anchor='middle'>Product Owner</text>
      <rect x='-55' y='78' width='110' height='24' rx='12' fill='#f0f9ff'/>
      <text x='0' y='94' font-family='sans-serif' font-size='12' font-weight='800' fill='#0284c7' text-anchor='middle'>⭐ Strategy</text>
    </g>

    <!-- Member 5: 3D Graphics Dev -->
    <g transform='translate(250, -30)' filter='url(#shadow)'>
      <rect x='-75' y='-150' width='150' height='270' rx='20' fill='#ffffff' stroke='#8b5cf6' stroke-width='2'/>
      <circle cx='0' cy='-70' r='46' fill='#8b5cf6'/>
      <text x='0' y='-60' font-family='sans-serif' font-size='28' font-weight='900' fill='#ffffff' text-anchor='middle'>EC</text>
      <text x='0' y='30' font-family='sans-serif' font-size='18' font-weight='800' fill='#0f172a' text-anchor='middle'>Elena Chen</text>
      <text x='0' y='55' font-family='sans-serif' font-size='14' font-weight='700' fill='#7c3aed' text-anchor='middle'>3D WebGL Dev</text>
      <rect x='-50' y='75' width='100' height='22' rx='11' fill='#f5f3ff'/>
      <text x='0' y='90' font-family='sans-serif' font-size='11' font-weight='700' fill='#7c3aed' text-anchor='middle'>Simulation</text>
    </g>

    <!-- Member 6: Scrum Master -->
    <g transform='translate(420, 0)' filter='url(#shadow)'>
      <rect x='-75' y='-150' width='150' height='270' rx='20' fill='#ffffff' stroke='#06b6d4' stroke-width='2'/>
      <circle cx='0' cy='-70' r='46' fill='#06b6d4'/>
      <text x='0' y='-60' font-family='sans-serif' font-size='28' font-weight='900' fill='#ffffff' text-anchor='middle'>DK</text>
      <text x='0' y='30' font-family='sans-serif' font-size='18' font-weight='800' fill='#0f172a' text-anchor='middle'>Devon Kim</text>
      <text x='0' y='55' font-family='sans-serif' font-size='14' font-weight='700' fill='#0891b2' text-anchor='middle'>Scrum Master</text>
      <rect x='-50' y='75' width='100' height='22' rx='11' fill='#ecfeff'/>
      <text x='0' y='90' font-family='sans-serif' font-size='11' font-weight='700' fill='#0891b2' text-anchor='middle'>Agile Delivery</text>
    </g>
  </g>

  <!-- Bottom Elegant Footer Pill -->
  <g transform='translate(800, 835)'>
    <rect x='-320' y='-22' width='640' height='44' rx='22' fill='#ffffff' stroke='#0284c7' stroke-width='1.5' filter='url(#shadow)'/>
    <text x='0' y='6' font-family='sans-serif' font-size='15' font-weight='700' fill='#475569' text-anchor='middle'>
      📸 Team Abu Photo Stage • Replace image in <tspan fill='#0284c7' font-weight='800'>public/team-photo.png</tspan>
    </text>
  </g>
</svg>